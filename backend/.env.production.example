# =============================================================================
# MAK Backend – PRODUCTION environment
# =============================================================================
# Copy to .env.production and set real values on the server / in your CI/CD.
# Do not commit .env.production or any file containing real secrets.
# =============================================================================

ENVIRONMENT=production
DEBUG=false

# Supabase – use production project
SUPABASE_URL=https://your-production-ref.supabase.co
SUPABASE_KEY=your-production-anon-or-service-role-key

# JWT – MUST be a long, random secret in production (e.g. openssl rand -hex 32)
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET

# CORS – list your production frontend origin(s) only
CORS_ORIGINS=https://your-app.example.com

# Auth
REFRESH_EXPIRE_DAYS=7
RATE_LIMIT_AUTH_PER_MINUTE=10

# SMTP – required for OTP and password reset in production
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password-or-app-password
EMAIL_FROM=noreply@your-domain.com

# Storage (Supabase bucket name)
STORAGE_BUCKET_SUBMISSIONS=task-submissions

# Cron – set a secret and pass it in the cron request header (e.g. X-Cron-Secret)
CRON_SECRET=REPLACE_WITH_RANDOM_CRON_SECRET

# Upload limits
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_EXTENSIONS=pdf,doc,docx,txt,xls,xlsx
