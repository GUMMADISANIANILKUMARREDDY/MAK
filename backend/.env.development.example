# =============================================================================
# MAK Backend – DEVELOPMENT environment
# =============================================================================
# Copy to .env.development (or .env) and fill in real values for local dev.
# Do not commit .env.development or .env – they are gitignored.
# =============================================================================

ENVIRONMENT=development
DEBUG=true

# Supabase (use your dev project or local Supabase)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# JWT – use a simple secret for dev only; never use in production
SECRET_KEY=dev-secret-key-change-in-production

# CORS – allow local frontend (comma-separated or * for all)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth
REFRESH_EXPIRE_DAYS=7
RATE_LIMIT_AUTH_PER_MINUTE=30

# SMTP (optional for dev – leave empty to skip sending emails)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Storage (Supabase bucket name)
STORAGE_BUCKET_SUBMISSIONS=task-submissions

# Cron (optional; leave empty in dev)
CRON_SECRET=

# Upload limits
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_EXTENSIONS=pdf,doc,docx,txt,xls,xlsx
